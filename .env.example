# Copy to .env.local and fill in. Leave unset to run in local-only mode
# (no sign-in, no cloud sync) — the app works fine without any of these.

# From Supabase Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# From Firebase Project Settings -> General -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
